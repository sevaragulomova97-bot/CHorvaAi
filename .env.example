# Nusxa oling: .env.example -> .env  (yoki Render/Vercel "Environment" bo‘limiga yozing)
# AI rejimi: auto | anthropic | gemini | demo
AI_PROVIDER=auto
# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Google Gemini (https://aistudio.google.com) — bepul limit mavjud
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Bir IP dan daqiqasiga nechta skan
SCAN_LIMIT_PER_MIN=12
# APK (Capacitor) uchun ruxsat etilgan manbalar, vergul bilan. * — hammasi
ALLOWED_ORIGINS=*
# TWA (Bubblewrap) APK uchun
TWA_PACKAGE=
TWA_SHA256=
